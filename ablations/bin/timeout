#!/usr/bin/env python3
"""Small GNU-timeout-compatible boundary used by pinned benchmark runners."""

from __future__ import annotations

import os
import signal
import subprocess
import sys
import time


def seconds(value: str) -> float:
    units = {"s": 1.0, "m": 60.0, "h": 3600.0, "d": 86400.0}
    suffix = value[-1:].lower()
    scale = units.get(suffix, 1.0)
    raw = value[:-1] if suffix in units else value
    duration = float(raw) * scale
    if duration < 0:
        raise ValueError("duration must be nonnegative")
    return duration


def main(argv: list[str]) -> int:
    kill_after = 0.0
    while argv and argv[0].startswith("--"):
        option = argv.pop(0)
        if option.startswith("--kill-after="):
            kill_after = seconds(option.partition("=")[2])
        else:
            print(f"timeout: unsupported option {option}", file=sys.stderr)
            return 125
    if len(argv) < 2:
        print("timeout: missing duration or command", file=sys.stderr)
        return 125
    try:
        limit = seconds(argv.pop(0))
    except ValueError as exc:
        print(f"timeout: invalid duration: {exc}", file=sys.stderr)
        return 125
    process = subprocess.Popen(argv, start_new_session=True)
    try:
        return process.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=kill_after)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
        return 124


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

