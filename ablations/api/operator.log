        "process": {"peak_rss_bytes": 1}, "provider_cost": None,
        "unavailable": {"provider_cost": "provider did not report cost"},
    }


def test_valid_receipt_is_admitted() -> None:
    validate_receipt(valid())


@pytest.mark.parametrize("change", ["replay", "unfinished", "judge", "usage", "trajectory", "tool"])
def test_incomplete_evidence_is_rejected(change: str) -> None:
    receipt = valid()
    if change == "replay": receipt["live"] = False
    if change == "unfinished": receipt["exit"]["state"] = "timeout"
    if change == "judge": receipt["judges"][0]["passed"] = False
    if change == "usage": del receipt["tokens"]["cached"]
    if change == "trajectory": receipt["memory"]["minted_trajectory"] = None
    if change == "tool": receipt["tools"]["calls"] = 0
    with pytest.raises(ReceiptError):
        validate_receipt(receipt)


def test_cross_harness_parity_rejects_budget_change() -> None:
    first, second = valid(), valid()
    second["harness"]["id"] = "harness2"
    assert_parity([first, second])
    second["config"]["budgets"]["steps"] = 3
    with pytest.raises(ReceiptError, match="parity"):
        assert_parity([first, second])


def test_mind_rescue_requires_prior_trace_and_exact_pair() -> None:
    off, on = valid(), valid()
    off["config"]["mind_enabled"] = False
    off["exit"]["state"] = "budget_exhausted"
    off["judges"][0]["passed"] = False
    on["memory"]["causal_traces"] = [{"source_id": "atom:old", "read_step": 1, "action_step": 2, "artifact": "answer", "judge_id": "j"}]
    assert_mind_ab(off, on)
    broken = copy.deepcopy(on)
    broken["memory"]["causal_traces"][0]["action_step"] = 1
    with pytest.raises(ReceiptError, match="before"):
        assert_mind_ab(off, broken)
from __future__ import annotations

import base64
import contextlib
import http.server
import json
import os
import pathlib
import subprocess
import threading


TOOL = pathlib.Path(__file__).parents[1] / "ablations" / "bridge" / "ple_tool.py"


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *_args):
        pass

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if self.path.endswith("/exec"):
            value = {"ok": True, "output": body["command"], "exit_code": 7, "timed_out": False}
        elif self.path.endswith("/read_file"):
            value = {"ok": True, "content_b64": base64.b64encode(body["path"].encode()).decode()}
        else:
            value = {"ok": True, "size": len(base64.b64decode(body["content_b64"]))}
        raw = json.dumps(value).encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)


@contextlib.contextmanager
def server():
    instance = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(target=instance.serve_forever, daemon=True)
    thread.start()
    try:
        yield f"http://127.0.0.1:{instance.server_port}/token"
    finally:
        instance.shutdown()
        thread.join()


def call(url: str, *args: str, input_text: str | None = None):
    return subprocess.run(
        [str(TOOL), *args], input=input_text, text=True, capture_output=True,
        env={**os.environ, "TASK_RELAY_URL": url}, timeout=3,
    )


def test_exec_preserves_output_and_exit_code() -> None:
    with server() as url:
        result = call(url, "exec", "hello")
    assert result.stdout == "hello" and result.returncode == 7


def test_read_and_write_round_trip_contract() -> None:
    with server() as url:
        assert call(url, "read", "/work/a").stdout == "/work/a"
        result = call(url, "write", "/work/a", "-", input_text="three")
    assert result.returncode == 0 and result.stdout.strip() == "5"


def test_rejects_untrusted_relay_and_bad_timeout() -> None:
    assert call("https://example.com/token", "read", "x").returncode == 125
    with server() as url:
        assert call(url, "exec", "x", "--timeout", "0").returncode == 125
