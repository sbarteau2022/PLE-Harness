#!/usr/bin/env bash
# Live cross-harness campaign launcher. Secrets exist only in a mode-600 temp file.
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="${PLE_ROOT:-/Users/stewartbarteau/Desktop/PhyEngLastExam}"
KIT="$ROOT/ple"
TASKS="$ROOT/ple-dev-set/tasks"

if [ -z "${NVIDIA_API_KEY:-}" ]; then
  NVIDIA_API_KEY="$(launchctl getenv NVIDIA_API_KEY 2>/dev/null || true)"
fi
if [ -z "${NVIDIA_API_KEY:-}" ]; then
  NVIDIA_API_KEY="$(security find-internet-password -s https://integrate.api.nvidia.com/v1 -w 2>/dev/null || true)"
fi
: "${NVIDIA_API_KEY:?NVIDIA_API_KEY is absent from environment, launchd, and keychain}"

ENV_FILE="$(mktemp -t ple-ablation-env)"
trap 'rm -f "$ENV_FILE"' EXIT
chmod 600 "$ENV_FILE"
{
  echo "MODEL_API_KEY=$NVIDIA_API_KEY"
  echo "JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1"
  echo "JUDGE_API_KEY=$NVIDIA_API_KEY"
  echo "JUDGE_MODEL=${JUDGE_MODEL:-mistralai/mistral-large-4-1t-a52b}"
} > "$ENV_FILE"

HARNESS="${1:-harness2}"
ACTION="${2:-check}"
MODEL="${MODEL:-mistral}"
case "$HARNESS:$MODEL" in
  harness2:mistral) ENTRY="$("$HERE/scripts/prepare_harness2_entry.sh")" ;;
  *) echo "unsupported campaign cell: $HARNESS:$MODEL" >&2; exit 2 ;;
esac

cd "$KIT"
case "$ACTION" in
  check)
    uv run python -m kit check "$ENTRY" --env-file "$ENV_FILE" --no-smoke --work "$HERE/ablations/work/$HARNESS-$MODEL"
    ;;
  run)
    TASK="${3:?usage: run_ablation.sh harness2 run TASK}"
    OUT="$HERE/ablations/runs/$HARNESS/$MODEL/$(date +%Y%m%d-%H%M%S)"
    caffeinate -dimsu uv run python eval/run.py "$ENTRY" --env-file "$ENV_FILE" \
      --tasks-dir "$TASKS" --tasks "$TASK" --trials 1 --attempts 1 --no-export --out "$OUT"
    ;;
  *) echo "action must be check or run" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# Build the minimal PLE kit source tree for the pinned Harness2 ablation.
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
ENTRY="$HERE/ablations/entries/harness2-mistral"
STAGE="$(mktemp -d "$HERE/ablations/.entry-harness2.XXXXXX")"
trap 'rm -rf "$STAGE"' EXIT

mkdir -p "$STAGE/ablations/bridge" \
  "$STAGE/ablations/vendor/harness2/dependencies" \
  "$STAGE/ablations/vendor/harness2"
cp -p "$HERE/submission.harness2.yaml" "$STAGE/submission.yaml"
cp -p "$HERE/serve_harness2.py" "$HERE/taskbridge.py" "$HERE/requirements.txt" "$STAGE/"
cp -p "$HERE/ablations/__init__.py" "$HERE/ablations/harness2_ple.py" "$STAGE/ablations/"
cp -p "$HERE/ablations/bridge/__init__.py" "$HERE/ablations/bridge/ple_tool.py" "$STAGE/ablations/bridge/"
cp -p "$HERE/ablations/vendor/harness2/pyproject.toml" \
  "$HERE/ablations/vendor/harness2/LICENSE" "$STAGE/ablations/vendor/harness2/"
rsync -a --exclude '__pycache__' \
  "$HERE/ablations/vendor/harness2/harness2/" "$STAGE/ablations/vendor/harness2/harness2/"
rsync -a --exclude '.git' --exclude 'node_modules' --exclude '.turbo' \
  "$HERE/ablations/vendor/harness2/dependencies/opencode/" \
  "$STAGE/ablations/vendor/harness2/dependencies/opencode/"

mkdir -p "$ENTRY"
rsync -a --delete "$STAGE/" "$ENTRY/"
git -C "$ENTRY" init -q
git -C "$ENTRY" add -A
git -C "$ENTRY" -c user.name='PLE Ablation Builder' -c user.email='local@invalid' \
  commit -q --no-gpg-sign -m 'generated pinned Harness2 entry'
echo "$ENTRY"

#!/usr/bin/env python3
"""Call the live PLE task relay from an external harness subprocess."""

from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from typing import Any


class RelayError(RuntimeError):
    pass


def _base() -> str:
    value = os.environ.get("TASK_RELAY_URL", "").rstrip("/")
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme != "http" or parsed.hostname not in {"127.0.0.1", "localhost"} or not parsed.path.strip("/"):
        raise RelayError("TASK_RELAY_URL must be the authenticated loopback relay URL")
    return value


def _request(route: str, body: dict[str, Any], timeout: int = 610) -> dict[str, Any]:
    request = urllib.request.Request(
        f"{_base()}/{route}",
        data=json.dumps(body, separators=(",", ":")).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read(64 << 20)
    except (urllib.error.URLError, TimeoutError) as exc:
        raise RelayError(f"relay request failed: {exc}") from exc
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RelayError("relay returned malformed JSON") from exc
    if not isinstance(value, dict):
        raise RelayError("relay response must be an object")
    if value.get("ok") is False or value.get("error"):
        raise RelayError(str(value.get("error") or "task operation failed"))
    return value


def execute(command: str, timeout: int) -> int:
    result = _request("exec", {"command": command, "timeout_sec": timeout}, timeout=timeout + 10)
    output = result.get("output", "")
    if not isinstance(output, str):
        raise RelayError("exec output is not text")
    sys.stdout.write(output)
    if result.get("timed_out") is True:
        return 124
    code = result.get("exit_code")
    if isinstance(code, bool) or not isinstance(code, int):
        raise RelayError("exec response has no integer exit_code")
    return code


def read_file(path: str) -> int:
    result = _request("read_file", {"path": path})
    encoded = result.get("content_b64")
    if not isinstance(encoded, str):
        raise RelayError("read response has no content_b64")
    try:
        data = base64.b64decode(encoded, validate=True)
    except ValueError as exc:
        raise RelayError("read response contains invalid base64") from exc
    sys.stdout.buffer.write(data)
    return 0


def write_file(path: str, source: str, append: bool) -> int:
    data = sys.stdin.buffer.read() if source == "-" else open(source, "rb").read()
    result = _request("write_file", {
        "path": path,
        "content_b64": base64.b64encode(data).decode(),
        "append": append,
    })
    size = result.get("size")
    if isinstance(size, bool) or not isinstance(size, int) or size < 0:
        raise RelayError("write response has no valid size")
    print(size)
    return 0


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="operation", required=True)
    run = commands.add_parser("exec")
    run.add_argument("command")
    run.add_argument("--timeout", type=int, default=300)
    read = commands.add_parser("read")
    read.add_argument("path")
    write = commands.add_parser("write")
    write.add_argument("path")
    write.add_argument("source", help="local source file, or - for stdin")
    write.add_argument("--append", action="store_true")
    return root


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.operation == "exec":
            if args.timeout < 1 or args.timeout > 600:
                raise RelayError("timeout must be in 1..600")
            return execute(args.command, args.timeout)
        if args.operation == "read":
            return read_file(args.path)
        return write_file(args.path, args.source, args.append)
    except (OSError, RelayError) as exc:
        print(f"ple-tool: {exc}", file=sys.stderr)
        return 125


if __name__ == "__main__":
    raise SystemExit(main())

